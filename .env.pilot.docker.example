# Copia este archivo como .env.pilot.docker antes de ejecutar Compose.
# Vite fija estas variables durante la construcción de la imagen. Son datos
# públicos del cliente web, pero deben apuntar al proyecto Supabase de producción.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-production-publishable-key

# La IP/hostname debe ser accesible por el Android en la LAN; no uses localhost.
KPL_PILOT_LAN_HOST=192.168.1.20
KPL_PILOT_LAN_CIDR=192.168.1.0/24
KPL_PILOT_CAMERA_PAGE_ORIGIN=https://live.kingspadelleague.es
# Orígenes HTTPS exactos autorizados a conectar desde Vercel. Separa varios con comas.
KPL_PILOT_CONTROL_ORIGINS=https://live.kingspadelleague.es

# YouTube es opcional para el piloto local.
KPL_PILOT_YOUTUBE_CREDENTIALS_PATH=
KPL_PILOT_YOUTUBE_CLIENT_ID=
KPL_PILOT_YOUTUBE_CLIENT_SECRET=
KPL_PILOT_YOUTUBE_REDIRECT_URI=http://localhost:4310/api/pilot/youtube/auth/callback
KPL_PILOT_YOUTUBE_TOKEN_PATH=/app/data/youtube-oauth.json

# Los puertos deben coincidir con los publicados por docker-compose.
KPL_PILOT_WEBRTC_PORT=8889
KPL_PILOT_WEBRTC_UDP_PORT=8189
KPL_PILOT_RTSP_PORT=8554
KPL_PILOT_MEDIAMTX_API_PORT=9998

# Nivel de log del servidor local.
LOG_LEVEL=info

# Acceso a GPU desde Docker: auto (predeterminado), nvidia, vaapi u off.
# NVIDIA requiere un runtime Docker compatible; VAAPI comparte los render nodes
# AMD/Intel de Linux. FFmpeg solo usará GPU si supera la prueba de codificación.
KPL_PILOT_GPU=auto
