# Copia estas variables al .env de la raíz, que ya está ignorado por Git.
# Crea un cliente OAuth de tipo "Aplicación web" en Google Cloud y autoriza
# exactamente esta URI de redirección.
KPL_PILOT_FFMPEG_PATH=/bin/ffmpeg
# Recomendado: referencia directamente el JSON descargado de Google Cloud.
KPL_PILOT_YOUTUBE_CREDENTIALS_PATH=/ruta/segura/client_secret.json
# Alternativa al JSON: completa las dos variables siguientes.
KPL_PILOT_YOUTUBE_CLIENT_ID=
KPL_PILOT_YOUTUBE_CLIENT_SECRET=
KPL_PILOT_YOUTUBE_REDIRECT_URI=http://localhost:4310/api/pilot/youtube/auth/callback
# Ruta absoluta fuera del repositorio. El servidor crea el archivo con modo 0600.
KPL_PILOT_YOUTUBE_TOKEN_PATH=/home/usuario/.local/state/kpl/youtube-oauth.json

# Cámara Android del piloto. Usa exactamente MediaMTX 1.21.0 y una IP/hostname
# del PC accesible desde la misma LAN que el móvil (nunca localhost).
KPL_PILOT_MEDIAMTX_PATH=/ruta/absoluta/mediamtx
KPL_PILOT_LAN_HOST=192.168.1.20
KPL_PILOT_LAN_CIDR=192.168.1.0/24
KPL_PILOT_CAMERA_PAGE_ORIGIN=https://live.kingspadelleague.es
# Orígenes HTTPS exactos autorizados a controlar este agente desde el navegador.
# Separa varios con comas si también usas una URL de preview de Vercel.
KPL_PILOT_CONTROL_ORIGINS=https://live.kingspadelleague.es
# TCP 8889 y UDP 8189 deben estar permitidos desde la LAN. RTSP y API quedan
# ligados exclusivamente a loopback dentro de la configuración efímera.
KPL_PILOT_WEBRTC_PORT=8889
KPL_PILOT_WEBRTC_UDP_PORT=8189
KPL_PILOT_RTSP_PORT=8554
KPL_PILOT_MEDIAMTX_API_PORT=9998
