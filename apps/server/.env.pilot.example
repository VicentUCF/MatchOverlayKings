# Copia estas variables al .env de la raíz, que ya está ignorado por Git.
# Crea un cliente OAuth de tipo "Aplicación web" en Google Cloud y autoriza
# exactamente esta URI de redirección.
KPL_PILOT_FFMPEG_PATH=/bin/ffmpeg
# Recomendado: referencia directamente el JSON descargado de Google Cloud.
KPL_PILOT_YOUTUBE_CREDENTIALS_PATH=/ruta/segura/client_secret.json
# Alternativa al JSON: completa las dos variables siguientes.
KPL_PILOT_YOUTUBE_CLIENT_ID=
KPL_PILOT_YOUTUBE_CLIENT_SECRET=
KPL_PILOT_YOUTUBE_REDIRECT_URI=http://localhost:4310/api/pilot/youtube/auth/callback
# Ruta absoluta fuera del repositorio. El servidor crea el archivo con modo 0600.
KPL_PILOT_YOUTUBE_TOKEN_PATH=/home/usuario/.local/state/kpl/youtube-oauth.json
