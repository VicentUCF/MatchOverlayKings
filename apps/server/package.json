{
  "name": "@kpl/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @kpl/shared && npm run build -w @kpl/production-contracts && npm run build -w @kpl/production-assets && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:pilot": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/pilot-index.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@kpl/production-assets": "0.1.0",
    "@kpl/production-contracts": "0.1.0",
    "@kpl/shared": "0.1.0",
    "fastify": "^5.12.4",
    "googleapis": "^180.0.0",
    "playwright": "^1.61.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0"
  }
}
