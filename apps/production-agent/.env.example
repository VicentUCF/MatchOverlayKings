# Sustituya los cuatro UUID por los UUID reales de pista-1 a pista-4. Deben ser el mismo conjunto que media-config.example.json.
KPL_AGENT_COURT_IDS=10000000-0000-4000-8000-000000000001,10000000-0000-4000-8000-000000000002,10000000-0000-4000-8000-000000000003,10000000-0000-4000-8000-000000000004
# El limite es fijo en el esquema: cuatro pistas configuradas y tres pipelines concurrentes.
KPL_AGENT_MAX_CONCURRENT_PIPELINES=3
KPL_AGENT_SUPABASE_URL=https://project.example.supabase.co
KPL_AGENT_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
KPL_AGENT_ACCESS_TOKEN=replace-with-agent-access-token
KPL_AGENT_SECRET_ROOT=/var/lib/kpl-agent/secrets
# Intervalo de sondeo valido: 100 a 60000 ms. Elija el valor para el sitio.
KPL_AGENT_POLL_INTERVAL_MS=1000
# Plazo global de parada valido: 1000 a 120000 ms. Elija el valor para el sitio.
KPL_AGENT_SHUTDOWN_DEADLINE_MS=30000
