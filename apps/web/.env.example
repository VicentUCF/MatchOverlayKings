VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
# Desde Vercel, conecta con el agente del mismo PC del operador.
VITE_LOCAL_AGENT_URL=http://127.0.0.1:4310

# Optional for Playwright e2e runs against a configured Supabase project.
KPL_E2E_EMAIL=admin@example.com
KPL_E2E_PASSWORD=replace-with-admin-password
