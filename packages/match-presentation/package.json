    "./styles/scoreboard-base.css": "./styles/scoreboard-base.css",
    "./styles/scoreboard-overlay.css": "./styles/scoreboard-overlay.css",
    "./styles/operator-actions.css": "./styles/operator-actions.css",
    "./styles/editor-overlay.css": "./styles/editor-overlay.css",
