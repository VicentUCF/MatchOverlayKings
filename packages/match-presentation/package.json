    "./styles/sponsor-ads.css": "./styles/sponsor-ads.css",
    "./styles/segmented-controls.css": "./styles/segmented-controls.css",
    "./styles/panels.css": "./styles/panels.css",
    "./styles/card-announcement-scene.css": "./styles/card-announcement-scene.css",
    "./styles/prematch-scene.css": "./styles/prematch-scene.css",
    "./styles/side-change-scene.css": "./styles/side-change-scene.css",
